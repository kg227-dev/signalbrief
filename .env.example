# Public base URL used in links (email/telegram/share pages)
BASE_URL=https://getsignalbrief.com

# Required runtime secrets (set from secret storage; never commit real values)
SIGNALBRIEF_ADMIN_EMAIL=admin@example.com
SIGNALBRIEF_ADMIN_SALT=replace-with-random-hex
SIGNALBRIEF_ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
SIGNALBRIEF_PERPLEXITY_API_KEY=replace-with-perplexity-key
SIGNALBRIEF_ANTHROPIC_API_KEY=replace-with-anthropic-key
SIGNALBRIEF_SIGNALBRIEF_BOT_TOKEN=replace-with-telegram-bot-token
SIGNALBRIEF_RESEND_API_KEY=replace-with-resend-key
SIGNALBRIEF_FROM_EMAIL=digest@getsignalbrief.com
SIGNALBRIEF_FROM_NAME=SignalBrief

# Optional provider/runtime secrets
# SIGNALBRIEF_TELEGRAM_BOT_TOKEN=replace-with-legacy-telegram-token
# SIGNALBRIEF_GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token
# SIGNALBRIEF_GOOGLE_CLIENT_ID=replace-with-google-client-id
# SIGNALBRIEF_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# TRUSTED_CORS_ORIGINS=https://getsignalbrief.com,https://www.getsignalbrief.com

# Optional ops alert destination for digest incidents
# OPS_ALERT_CHAT_ID=123456789

# Optional production signup guard override (default blocked in NODE_ENV=production)
# ALLOW_EXAMPLE_SIGNUPS=0

# Optional worker tuning (defaults shown)
# DIGEST_POLL_MS=300000
# DIGEST_STARTUP_DELAY_MS=5000
# DIGEST_RUN_ON_STARTUP=1
# DIGEST_RUN_TIMEOUT_MS=1500000

# Optional explicit heartbeat path shared by web + worker
# SCHEDULER_HEARTBEAT_FILE=/app/data/scheduler-heartbeat.json
