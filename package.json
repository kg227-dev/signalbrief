{
  "name": "signalbrief",
  "version": "1.0.0",
  "description": "AI-curated daily news digest for healthcare strategy professionals",
  "main": "src/entrypoints/digest.js",
  "scripts": {
    "start": "node src/entrypoints/digest.js",
    "web": "node web/server.js",
    "bot": "node src/entrypoints/bot-server.js",
    "worker": "node src/entrypoints/scheduler-worker.js",
    "check:module-linkage": "node --check scripts/check-module-linkage.mjs",
    "smoke:worker": "node scripts/smoke-worker.js",
    "smoke:admin-scheduler": "node scripts/smoke-admin-scheduler.js",
    "ops:verify-runtime": "node scripts/verify-runtime.js",
    "ops:verify-runtime:quick": "node scripts/verify-runtime.js --skip-canary",
    "ops:watchdog-scheduler": "node scripts/watchdog-scheduler.js",
    "smoke:digest": "node src/entrypoints/digest.js --dry-run",
    "test": "node scripts/test-critical-paths.js",
    "qa:harness": "node test-harness/run-tests.js --deterministic",
    "qa:benchmark": "node test-harness/run-tests.js",
    "qa:matrix": "node test-harness/run-matrix.js",
    "report:marketing-weekly": "node scripts/report-marketing-weekly.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^10.0.3"
  }
}
